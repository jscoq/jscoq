{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "outDir": "dist",
    // "lib": ["esnext", "dom", "dom.iterable", "webworker"],
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "downlevelIteration": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    // "checkJs": true
    "noEmit": true
  },
  "include": [ "frontend/**/*.ts", "backend/**/*.ts", "lib/**/*.ts"],
  "exclude": [".git", "_build", "dist", "dist-cli", "dist-pkg", "node_modules/**/*", "backend/wasm/shims", "vendor", "frontend/classic/js/addon/**/*.js", "frontend/classic/js/addon/company-coq.js", "frontend/classic/js/mode/*.js"]
}
